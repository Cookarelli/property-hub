NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add a service_role key to a NEXT_PUBLIC_ variable.

# Public leasing: local PostgreSQL by default outside Vercel.
# Optional persistent local directory (one app process per directory).
PROPERTY_HUB_DEMO_DB_PATH=
# For a dedicated, seeded Supabase DEMO project on Vercel:
# PROPERTY_HUB_LEASING_BACKEND=supabase-demo
# PROPERTY_HUB_DEMO_ORGANIZATION_ID=00000001-0000-4000-8000-000000000001
# SUPABASE_SECRET_KEY=
# Never prefix a secret key with NEXT_PUBLIC_.
# PROPERTY_HUB_LEASING_BACKEND=disabled rejects new intake requests.

# Set once per platform deployment for verified-account invitation callbacks.
PROPERTY_HUB_APP_URL=http://localhost:3000
