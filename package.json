{
  "name": "property-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:seed:generate": "node --import tsx scripts/seed.ts --write",
    "db:test": "node --import tsx scripts/check-database.ts",
    "db:types": "node --import tsx scripts/check-database.ts --generate-types",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm db:test && pnpm build",
    "test:unit": "node --import tsx --test scripts/check-organization-policy.ts",
    "db:migrate:local": "node --import tsx scripts/migrate-local.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "0.38.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.7",
    "shadcn": "^4.21.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module"
}
